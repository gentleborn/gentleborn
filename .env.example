# Gentleborn environment variables
# Copy this file to .env.local for development. Never commit .env.local.
#
# Day 1-7 (synthetic data) uses FREE-TIER values everywhere.
# Post-BAA: swap SUPABASE_* to HIPAA-tier project, swap STEDI_* to
# production, and swap GENTLEBORN_PHI_KEY to a Vault-managed secret.

# ============================================================
# Supabase
# ============================================================
# From: https://supabase.com/dashboard/project/<ref>/settings/api
# Day 1-7: gentleborn-stack (free tier).
# Post-BAA: HIPAA-tier project, BAA countersigned.
NEXT_PUBLIC_SUPABASE_URL=https://trglagdeoihtnwmgrxie.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_49uj_xOPfp7smJnSxqHu_w_AMRRFS5A

# Service role key. Server-only. Never exposed to client. Has full DB
# access (bypasses RLS). Treat like a root password.
# Find in: Dashboard > Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=set-me-via-dashboard

# ============================================================
# PHI encryption (lib/crypto)
# ============================================================
# Day 1-7: a 32-byte (64-hex-char) AES-256-GCM key. Generate with:
#   openssl rand -hex 32
# Post-BAA: switch to Supabase Vault; this var becomes unused.
GENTLEBORN_PHI_KEY=set-me-with-openssl-rand-hex-32

# ============================================================
# Stedi (clearinghouse)
# ============================================================
# Day 1-7: sandbox endpoint + test API key.
# Post-EDI-Trading-Partner-approval: production endpoint.
STEDI_BASE_URL=https://healthcare.us.stedi.com
STEDI_API_KEY=set-me-via-stedi-dashboard
STEDI_BILLING_NPI=set-me-to-gentleborn-npi-type2

# Stedi payer + trading partner IDs. Sandbox values for Day 1-7.
# DMAS prod payer ID is different; switch post-approval.
STEDI_PAYER_ID_DMAS=SANDBOX_DMAS
STEDI_TRADING_PARTNER_ID=SANDBOX_TP

# ============================================================
# NPPES (public free API, no key)
# ============================================================
NPPES_BASE_URL=https://npiregistry.cms.hhs.gov

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
